#!/usr/bin/env bash
set -euo pipefail

agentknock_project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
agentknock_data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
agentknock_credentials_dir="${agentknock_data_home}/agentknock-android"

if [[ -n "$(git -C "${agentknock_project_dir}" status --porcelain --untracked-files=all -- app build.gradle.kts settings.gradle.kts gradle.properties gradle gradlew flake.nix flake.lock publish-internal)" ]]; then
    echo "Refusing to publish with uncommitted build inputs." >&2
    exit 1
fi

export AGENTKNOCK_PLAY_CREDENTIALS_FILE="${agentknock_credentials_dir}/play-publisher.json"
export AGENTKNOCK_UPLOAD_STORE_FILE="${agentknock_credentials_dir}/upload-keystore.p12"
export AGENTKNOCK_UPLOAD_KEY_ALIAS="agentknock-upload"
export AGENTKNOCK_SOURCE_REVISION="$(git -C "${agentknock_project_dir}" rev-parse --short=12 HEAD)"

for agentknock_required_file in \
    "${AGENTKNOCK_PLAY_CREDENTIALS_FILE}" \
    "${AGENTKNOCK_UPLOAD_STORE_FILE}"
do
    if [[ ! -f "${agentknock_required_file}" ]]; then
        echo "Missing release credential: ${agentknock_required_file}" >&2
        exit 1
    fi
done

cd "${agentknock_project_dir}"
exec agentknock --secret agentknock-android-upload-passphrase \
    --reason "Sign and upload an Agentknock Android release to Google Play internal testing." \
    -- nix develop --command ./gradlew publishReleaseBundle "$@"
