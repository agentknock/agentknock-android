#!/usr/bin/env bash
set -euo pipefail

if [[ $# != 1 || "$1" != *.aab || ! -f "$1" ]]; then
    echo 'Usage: ./publish-internal SIGNED_PLAY_BUNDLE.aab' >&2
    exit 2
fi
agentknock_bundle="$(realpath -- "$1")"
agentknock_project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
agentknock_data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
export AGENTKNOCK_PLAY_CREDENTIALS_FILE="${agentknock_data_home}/agentknock-android/play-publisher.json"
if [[ ! -f "$AGENTKNOCK_PLAY_CREDENTIALS_FILE" ]]; then
    echo "Missing Play API credential: $AGENTKNOCK_PLAY_CREDENTIALS_FILE" >&2
    exit 1
fi
cd -- "$agentknock_project_dir"

agentknock_signed_dir="$(mktemp -d)"
trap 'rm -rf -- "$agentknock_signed_dir"' EXIT
cp -- "$agentknock_bundle" "$agentknock_signed_dir/app-release.aab"
python3 - "$agentknock_signed_dir" <<'PY'
from pathlib import Path
import subprocess
import sys
import xml.etree.ElementTree as ET

sys.path.insert(0, "scripts")
from release_signing import PLAY_UPLOAD_CERTIFICATE, verify_bundle
from version import BUILD_FILE, version_code

directory = Path(sys.argv[1])
bundle = directory / "app-release.aab"
verify_bundle(bundle, PLAY_UPLOAD_CERTIFICATE, directory)
subprocess.run(["bundletool", "validate", f"--bundle={bundle}"], check=True)
manifest = ET.fromstring(subprocess.check_output([
    "bundletool", "dump", "manifest", f"--bundle={bundle}", "--module=base",
]))
android = "{http://schemas.android.com/apk/res/android}"
if (manifest.get("package") != "dev.agentknock"
        or manifest.get(android + "versionName") != Path("version.txt").read_text().strip()
        or manifest.get(android + "versionCode") != str(version_code(Path(BUILD_FILE).read_text()))):
    raise ValueError("Check out the source release matching this signed bundle before uploading")
PY
sha256sum "$agentknock_signed_dir/app-release.aab"
./gradlew publishPlayReleaseBundle --artifact-dir "$agentknock_signed_dir"
