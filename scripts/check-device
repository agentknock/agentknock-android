#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

: "${AGENTKNOCK_EMULATOR_IMAGE:?Set the emulator system image}"
: "${AGENTKNOCK_EMULATOR_API:?Set the emulator API level}"

if [[ $# != 2 ]]; then
    echo "Usage: scripts/check-device {foss|play} {instrumentation|release}" >&2
    exit 2
fi
distribution=$1
check_kind=$2
case "$distribution" in
    foss|play) ;;
    *) echo "Unknown distribution: $distribution" >&2; exit 2 ;;
esac
case "$check_kind" in
    instrumentation)
        artifacts=(
            "app/build/outputs/apk/$distribution/debug/app-$distribution-debug.apk"
            "app/build/outputs/apk/androidTest/$distribution/debug/app-$distribution-debug-androidTest.apk"
        )
        ;;
    release)
        case "$distribution" in
            foss) artifacts=(app/build/outputs/apk/foss/release/app-foss-release-unsigned.apk) ;;
            play) artifacts=(app/build/outputs/bundle/playRelease/app-play-release.aab) ;;
        esac
        ;;
    *) echo "Unknown device check: $check_kind" >&2; exit 2 ;;
esac
for artifact in "${artifacts[@]}"; do
    if [[ ! -f "$artifact" ]]; then
        echo "Missing device-test artifact: $artifact" >&2
        exit 1
    fi
done

device_serial=emulator-5556
connected_devices="$(adb devices)"
if grep -Eq "^${device_serial}[[:space:]]" <<< "$connected_devices"; then
    echo "$device_serial is already in use; refusing to replace it." >&2
    exit 1
fi

device_test_dir="$(mktemp -d)"
device_report_dir="$PWD/app/build/reports/device-checks/$distribution/$check_kind/api-$AGENTKNOCK_EMULATOR_API"
mkdir -p "$device_report_dir"
export ANDROID_AVD_HOME="$device_test_dir/avd"
mkdir -p "$ANDROID_AVD_HOME"
emulator_pid=

cleanup() {
    local result=$?
    if [[ -n "$emulator_pid" ]]; then
        timeout 10 adb -s "$device_serial" logcat -d > "$device_report_dir/logcat.txt" 2>&1 || true
        if (( result != 0 )); then
            echo 'Emulator feature configuration:' >&2
            grep -Ei 'feature|api level|systempath' "$device_report_dir/emulator.txt" >&2 || true
            echo 'Emulator output:' >&2
            tail -n 60 "$device_report_dir/emulator.txt" >&2
            echo 'Android crashes:' >&2
            timeout 10 adb -s "$device_serial" logcat -d -b crash >&2 || true
            echo 'Recent Android errors:' >&2
            timeout 10 adb -s "$device_serial" logcat -d -t 100 '*:E' >&2 || true
        fi
        timeout 10 adb -s "$device_serial" emu kill >/dev/null 2>&1 || true
        kill "$emulator_pid" 2>/dev/null || true
        wait "$emulator_pid" 2>/dev/null || true
        timeout 10 adb -s "$device_serial" wait-for-disconnect || true
    fi
    rm -rf -- "$device_test_dir"
}
trap cleanup EXIT

printf 'no\n' | avdmanager create avd --name agentknock_ci \
    --package "$AGENTKNOCK_EMULATOR_IMAGE" --device pixel_7
emulator_options=(-gpu swiftshader -memory 2048)
if [[ "$AGENTKNOCK_EMULATOR_API" == 37 ]]; then
    # API 37's mapper needs both host memory features for DMA readback.
    emulator_options=(-gpu swiftshader -memory 4096 -feature 'GLDirectMem,HasSharedSlotsHostMemoryAllocator')
fi
# Google services exceed the hosted SDK's default writable partition during boot.
emulator -avd agentknock_ci -port 5556 -accel on -no-window -no-audio -no-boot-anim -no-metrics -verbose \
    -no-snapshot -partition-size 4096 -cores 2 "${emulator_options[@]}" \
    > "$device_report_dir/emulator.txt" 2>&1 &
emulator_pid=$!

boot_deadline=$((SECONDS + 360))
until [[ "$(adb -s "$device_serial" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" == 1 ]]; do
    if ! kill -0 "$emulator_pid" 2>/dev/null; then
        echo "Emulator exited before finishing boot." >&2
        tail -n 60 "$device_report_dir/emulator.txt" >&2
        exit 1
    fi
    if (( SECONDS >= boot_deadline )); then
        echo "Emulator did not finish booting." >&2
        exit 1
    fi
    sleep 1
done
actual_api="$(adb -s "$device_serial" shell getprop ro.build.version.sdk | tr -d '\r')"
if [[ "$actual_api" != "$AGENTKNOCK_EMULATOR_API" ]]; then
    echo "Expected emulator API $AGENTKNOCK_EMULATOR_API, got $actual_api." >&2
    exit 1
fi
adb -s "$device_serial" shell input keyevent 82
for setting in window_animation_scale transition_animation_scale animator_duration_scale; do
    adb -s "$device_serial" shell settings put global "$setting" 0
done

# Boot completion is signalled before Google services finish their first-boot work.
timeout 300 adb -s "$device_serial" shell am wait-for-broadcast-idle \
    | tee "$device_report_dir/system-ready.txt"
grep -Fq 'All broadcast queues are idle!' "$device_report_dir/system-ready.txt"

if [[ "$check_kind" == instrumentation ]]; then
    for artifact in "${artifacts[@]}"; do
        adb -s "$device_serial" install "$artifact"
    done
    adb -s "$device_serial" shell am instrument -w \
        dev.agentknock.test/androidx.test.runner.AndroidJUnitRunner \
        | tee "$device_report_dir/instrumentation.txt"
    # adb can exit successfully even when instrumentation crashes or reports failed tests.
    grep -Eq '^OK \([1-9][0-9]* tests?\)' "$device_report_dir/instrumentation.txt"
    echo "Instrumentation passed."
    exit 0
fi

# Exercise the actual R8 output using a disposable signing key and a clean install.
keytool -genkeypair -keystore "$device_test_dir/test-key.p12" -storetype PKCS12 \
    -alias ci -storepass android -keypass android -keyalg RSA -keysize 2048 \
    -validity 1 -dname 'CN=Agentknock CI test'
case "$distribution" in
    foss)
        "$ANDROID_HOME/build-tools/36.0.0/apksigner" sign \
            --ks "$device_test_dir/test-key.p12" --ks-key-alias ci --ks-pass pass:android \
            --out "$device_test_dir/release.apk" "${artifacts[0]}"
        adb -s "$device_serial" install "$device_test_dir/release.apk"
        ;;
    play)
        bundletool build-apks --bundle="${artifacts[0]}" \
            --output="$device_test_dir/release.apks" --connected-device --device-id="$device_serial" \
            --aapt2="$ANDROID_HOME/build-tools/36.0.0/aapt2" \
            --ks="$device_test_dir/test-key.p12" --ks-key-alias=ci --ks-pass=pass:android
        bundletool install-apks --apks="$device_test_dir/release.apks" --device-id="$device_serial"
        ;;
esac
adb -s "$device_serial" shell am start -W -n dev.agentknock/.MainActivity \
    | tee "$device_report_dir/release-startup.txt"
grep -q '^Status: ok' "$device_report_dir/release-startup.txt"
welcome_deadline=$((SECONDS + 60))
while true; do
    adb -s "$device_serial" shell pidof dev.agentknock
    adb -s "$device_serial" shell uiautomator dump /sdcard/agentknock-ci.xml
    adb -s "$device_serial" pull /sdcard/agentknock-ci.xml "$device_report_dir/release-ui.xml"
    if python3 - "$device_report_dir/release-ui.xml" <<'PY'
import sys
import xml.etree.ElementTree as ET

nodes = ET.parse(sys.argv[1]).getroot().iter("node")
welcome_visible = any(
    node.get("package") == "dev.agentknock" and node.get("text") == "Welcome to Agentknock"
    for node in nodes
)
raise SystemExit(0 if welcome_visible else 1)
PY
    then
        break
    fi
    if (( SECONDS >= welcome_deadline )); then
        echo 'The minified release did not display the welcome screen. Observed UI:' >&2
        cat "$device_report_dir/release-ui.xml" >&2
        exit 1
    fi
    sleep 1
done
adb -s "$device_serial" shell pidof dev.agentknock
echo "Minified release startup passed."
