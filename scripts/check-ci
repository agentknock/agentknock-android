#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

: "${AGENTKNOCK_SOURCE_REVISION:?Set the source revision for the release build}"

actionlint
shellcheck publish-internal publish-subscriptions preview-ui scripts/check-ci scripts/check-device

./gradlew --no-daemon --max-workers=2 \
    test lintDebug lintRelease assembleDebug assembleDebugAndroidTest \
    bundleRelease generateReleasePlayResources

if [[ -n "$(git status --porcelain --untracked-files=all -- app/schemas)" ]]; then
    echo "Room schema exports changed during the build; commit the schema and its migration." >&2
    git status --short -- app/schemas
    exit 1
fi

python3 scripts/check-release.py
